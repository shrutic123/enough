{
  "name": "enough",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -b",
    "demo:capture": "node demo/capture-session.mjs",
    "demo:record": "node demo/record.mjs",
    "demo:encode": "bash demo/to-mp4.sh",
    "demo": "npm run demo:record && npm run demo:encode"
  },
  "dependencies": {
    "express": "^4.21.2",
    "iron-session": "^9.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "playwright": "^1.65.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
