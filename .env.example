# Buffer app client credentials. Create them in Buffer under Settings > API.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=

# Must match the redirect URI registered in Buffer exactly, character for character.
# Buffer requires HTTPS, even on localhost. Vite serves HTTPS via @vitejs/plugin-basic-ssl.
REDIRECT_URI=https://localhost:5173/api/auth/callback

# Generate with: openssl rand -hex 32
# Optional locally, required in production.
SESSION_SECRET=

# AI provider for the Essence trim. Set ONE key; the server uses the first one
# present (Gemini, then OpenAI, then Anthropic). These stay server-side only.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the provider's default model (gemini-3.5-flash-lite,
# gpt-4.1-mini, claude-sonnet-4-5). Leave empty to use the default. Gemini
# falls back to gemini-3.5-flash when the first model errors or takes longer
# than twelve seconds.
AI_MODEL=

# Local API server port. Vite proxies /api here.
PORT=3001
